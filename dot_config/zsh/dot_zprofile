#export TERMINFO="$XDG_DATA_HOME"/terminfo
#export TERMINFO_DIRS="$XDG_DATA_HOME"/terminfo:/usr/share/terminfo

##### Antigravity #####
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

###### Docker ######
export DOCKER_CONFIG="$XDG_CONFIG_HOME"/docker

##### Julia #####
export JULIA_NUM_THREADS=7

##### uv #####
export PATH="$HOME/.local/bin:$PATH"

###### Homebrew ######
eval "$(/opt/homebrew/bin/brew shellenv)"

# Homebrew ncurses tools (keg-only)
if command -v brew >/dev/null 2>&1; then
  _ncurses_bin="$(brew --prefix ncurses 2>/dev/null)/bin"
  [[ -d "$_ncurses_bin" ]] && export PATH="$_ncurses_bin:$PATH"
fi

###### mise shims for login and non-interactive sessions ######
eval "$(mise activate zsh --shims)"

# 最後に PATH を重複排除（順序は「先に出てきたもの」が残る）
typeset -U path PATH
export PATH
